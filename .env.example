# Server Configuration
PORT=3000
NODE_ENV=development

# Socket.IO & Network Configuration
# For Android Emulator connecting to local host machine: use http://10.0.2.2:3000
# For Physical Android phones on local Wi-Fi: use http://<YOUR_LOCAL_IP>:3000
ALLOWED_ORIGINS=*
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration (PostgreSQL - Step 5+)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auction_game_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
