# ========================================================
# PowerBid Production Environment Variables Template
# ========================================================
# DO NOT commit real secrets to source control.
# Copy this template to .env on your cloud server or set via PaaS environment settings.

# Node Environment & Port
NODE_ENV=production
PORT=3000

# CORS & Network Origin
# Restrict to your registered app domain in production (e.g. https://powerbid.app) or * for mobile
CORS_ORIGIN=*

# Cryptographic Token Signing Secret (Minimum 32 random alphanumeric characters)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS

# PostgreSQL Persistent Database Credentials
# Compatible with Supabase, Neon, AWS RDS, Railway, Render, or Self-Hosted Postgres
DB_HOST=your-postgres-host.example.com
DB_PORT=5432
DB_NAME=powerbid_production
DB_USER=powerbid_db_user
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DB_SSL=true

# Public Base URL (Used for generating shareable deep links and invitation web previews)
PUBLIC_APP_URL=https://api.powerbid.game
